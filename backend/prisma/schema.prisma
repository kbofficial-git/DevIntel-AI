datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

/// Initial system verification model to test database connectivity & migration setup
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

/// Authenticated platform user — created/updated on each GitHub OAuth login
model User {
  id            String         @id @default(uuid())
  githubId      Int            @unique
  login         String         @unique
  name          String?
  email         String?
  avatarUrl     String?
  /// GitHub OAuth access token — stored server-side, NEVER sent to frontend
  githubToken   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  repositories  Repository[]
  conversations Conversation[]
  feedbacks     Feedback[]

  @@map("users")
}

/// GitHub repository connected to DevIntel by a user
model Repository {
  id            String         @id @default(uuid())
  userId        String
  githubRepoId  Int
  name          String
  fullName      String
  owner         String
  description   String?
  defaultBranch String         @default("main")
  private       Boolean        @default(false)
  githubUrl     String
  language      String?
  lastIndexedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingestionJobs IngestionJob[]
  codeChunks    CodeChunk[]
  conversations Conversation[]
  feedbacks     Feedback[]

  /// Each user can connect a given GitHub repo only once
  @@unique([userId, githubRepoId])
  @@index([userId])
  @@map("repositories")
}

enum IngestionStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model IngestionJob {
  id             String          @id @default(uuid())
  repositoryId   String
  status         IngestionStatus @default(QUEUED)
  totalFiles     Int             @default(0)
  processedFiles Int             @default(0)
  totalChunks    Int             @default(0)
  errorMessage   String?
  commitSha      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("ingestion_jobs")
}

model CodeChunk {
  id           String                      @id @default(uuid())
  repositoryId String
  filePath     String
  language     String
  startLine    Int
  endLine      Int
  symbolName   String?
  content      String                      @db.Text
  contentHash  String
  commitSha    String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  repository   Repository                  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([repositoryId, filePath])
  @@map("code_chunks")
}

model Conversation {
  id           String       @id @default(uuid())
  userId       String
  repositoryId String
  title        String       @default("New Conversation")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userId, repositoryId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String       @db.Text
  citations      Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Feedback {
  id           String     @id @default(uuid())
  userId       String
  repositoryId String
  capability   String     // 'chat' | 'review' | 'debug' | 'plan'
  rating       Int        // 1 (positive) or -1 (negative)
  comment      String?
  referenceId  String?
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([userId])
  @@map("feedback")
}

