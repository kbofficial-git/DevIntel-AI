# ==============================================================================
# DevIntel AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your configuration.
# DO NOT commit real secrets or credentials to version control.

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (with pgvector support)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devintel_ai?schema=public

# Redis & Background Jobs (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# GitHub OAuth Application
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Authentication & Session Security
SESSION_SECRET=your_long_random_session_secret_change_in_production
JWT_SECRET=your_jwt_secret_key_change_in_production
COOKIE_DOMAIN=localhost

# AI & Embedding Provider Configuration
AI_PROVIDER=openai
AI_API_KEY=your_ai_provider_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion Constraints & Bounds
MAX_FILE_SIZE_KB=500
MAX_REPO_SIZE_MB=50

# Logging & Observability
LOG_LEVEL=info
